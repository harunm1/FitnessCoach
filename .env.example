# Copy to .env (never committed). Start local PostgreSQL with Docker Compose:
#   docker compose up -d
#   docker compose ps  # Wait for the postgres service to report healthy.
DATABASE_URL="postgresql://fitnesscoach:fitnesscoach@localhost:5432/fitnesscoach?schema=public"

# Coach model (issue #11): groq (default) or gemini. Keys from console.groq.com
# and aistudio.google.com; put the values in .env only.
COACH_PROVIDER="groq"
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Better Auth: generate a secret with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# SMTP for verification and password reset. Local Mailpit defaults:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="FitnessCoach <noreply@fitnesscoach.local>"
# Set these together only if your SMTP server requires authentication.
SMTP_USER=
SMTP_PASSWORD=

# Optional: dedicated database for integration/browser tests; name must end in _test.
# TEST_DATABASE_URL=postgresql://fitnesscoach:fitnesscoach@localhost:15432/fitnesscoach_test?schema=public

# Stripe test-mode subscriptions (optional; see docs/BILLING.md).
# Leave blank until you configure a Stripe sandbox and local webhook listener.
STRIPE_SECRET_KEY=
# Optional compatibility ID: retain it if existing subscribers use this price.
STRIPE_PRICE_ID=
# Explicit prices enable both options. Use IDs from the same sandbox product.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
