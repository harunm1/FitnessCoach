# Copy to .env (never committed). Start local PostgreSQL with Docker Compose:
#   docker compose up -d
#   docker compose ps  # Wait for the postgres service to report healthy.
DATABASE_URL="postgresql://fitnesscoach:fitnesscoach@localhost:5432/fitnesscoach?schema=public"

# Better Auth: generate a secret with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=57278239852e13f200d64b554fe86004c59107370d32759ebf5d487af79b0862

# SMTP for verification and password reset. Local Mailpit defaults:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="FitnessCoach <noreply@fitnesscoach.local>"
# Set these together only if your SMTP server requires authentication.
SMTP_USER=
SMTP_PASSWORD=

# Optional: dedicated database for integration/browser tests; name must end in _test.
# TEST_DATABASE_URL=postgresql://fitnesscoach:fitnesscoach@localhost:15432/fitnesscoach_test?schema=public
