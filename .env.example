# Copy to .env (never committed). Start local PostgreSQL with Docker Compose:
#   docker compose up -d
#   docker compose ps  # Wait for the postgres service to report healthy.
DATABASE_URL="postgresql://fitnesscoach:fitnesscoach@localhost:5432/fitnesscoach?schema=public"

# Coach model (issue #11): groq (default) or gemini. Keys from console.groq.com
# and aistudio.google.com; put the values in .env only.
COACH_PROVIDER="groq"
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Hosted preview (docs/ARCHITECTURE.md D15, README "Deploy"). Leave unset locally: when
# set, the Prisma CLI (migrate) uses it while the app and seed use DATABASE_URL.
# On Vercel with Neon: DATABASE_URL is the pooled string (host contains -pooler) for
# the app; DATABASE_URL_UNPOOLED is the direct string the Prisma CLI uses for
# `prisma migrate deploy`. Set both, plus COACH_PROVIDER and the two keys above, in
# the Vercel project's Environment Variables; never commit them.
DATABASE_URL_UNPOOLED=""
