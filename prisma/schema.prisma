// FitnessCoach data model. Prisma ORM v7, PostgreSQL (ECE1724 Lecture 3, pp. 44 to 66).
// Schema is what the database should look like; migrations are how it gets there
// (L3 p64). Change this file, then `npx prisma migrate dev --name <change>` and commit
// both the schema and the migration folder.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // `where` on @@unique (partial unique indexes on Plan and Workout), Preview since 7.4.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Range CHECK constraints on SetLog, RunLog, PlanExercise, PlanRun, PlanDay and Profile
// live only in migration 20261124180300_range_checks: Prisma cannot declare CHECK, so
// this file does not show them, and `prisma db pull` only marks those models as having
// check constraints (#76).

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

// The four access tiers checked on the server (docs/ARCHITECTURE.md, advanced features).
// FREE: quiz and a default plan. TRIAL and PRO: the coach. ADMIN: the exercise library.
enum Tier {
  FREE
  TRIAL
  PRO
  ADMIN
}

// String id and the name/email/emailVerified/image columns match what Better Auth's
// Prisma adapter expects, so the Accounts area can add its session and account tables
// without touching the rest of the schema.
model User {
  id                       String       @id @default(cuid())
  name                     String
  email                    String       @unique
  emailVerified            Boolean      @default(false)
  image                    String?
  tier                     Tier         @default(FREE)
  trialEndsAt              DateTime?
  lastCoachPlanRequestedAt DateTime?
  // Display units only (D30): every stored weight is kg and every distance km.
  weightUnit               WeightUnit   @default(LB)
  distanceUnit             DistanceUnit @default(KM)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  sessions Session[]
  accounts Account[]
  billing  BillingAccount?

  profile       Profile?
  plans         Plan[]
  workouts      Workout[]
  conversations Conversation[]
  photos        ProgressPhoto[]
  bodyWeights   BodyWeight[]
  coachEvents   CoachEvent[]
  exports       DataExport[]
}

// ---------------------------------------------------------------------------
// Quiz and exercise library
// ---------------------------------------------------------------------------

enum WeightUnit {
  KG
  LB
}

enum DistanceUnit {
  KM
  MI
}

enum Goal {
  STRENGTH
  MUSCLE
  FAT_LOSS
  GENERAL_FITNESS
}

enum Level {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

// What the user trains for: the gym, running or both (meeting 2, #12, #34).
enum TrainingMode {
  GYM
  RUNNING
  BOTH
}

// How active the user's day is outside training; with occupation it sets volume and
// rest days in the plan (#33, #34).
enum ActivityLevel {
  SEDENTARY // desk job or study
  LIGHT
  ACTIVE
  PHYSICAL_JOB // on their feet or lifting at work
}

// One profile per user: the quiz answers the coach is grounded on.
// One-to-one, so the foreign key lives here and is unique (L3 p61, L6 p37 on where
// the foreign key goes).
model Profile {
  id            Int           @id @default(autoincrement())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal
  level         Level
  trainingMode  TrainingMode  @default(GYM)
  daysPerWeek   Int
  // Equipment names from the exercise library ("barbell", "dumbbell", "body only"...),
  // so the verifier can check a plan against what the user actually has.
  equipment     String[]
  injuries      String?
  occupation    String? // free text from the quiz, e.g. "nurse, 12-hour shifts"
  activityLevel ActivityLevel @default(LIGHT)
  updatedAt     DateTime      @updatedAt
}

// Seeded from free-exercise-db (public domain, docs/RESEARCH.md). The coach picks
// exercises by id from this table and cannot name one we do not have.
model Exercise {
  id               String   @id // free-exercise-db slug, e.g. "Barbell_Bench_Press_-_Medium_Grip"
  name             String
  level            Level
  equipment        String?
  category         String
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  images           String[] // paths under the free-exercise-db image base URL
  // Form cues and common mistakes we write ourselves (issue #8); the coach's form
  // feedback must trace to this text, not to the model's own ideas.
  cues             String[]
  commonMistakes   String[]

  planExercises PlanExercise[]
  setLogs       SetLog[]
  messages      Message[]
}

// ---------------------------------------------------------------------------
// Plans
// ---------------------------------------------------------------------------

enum PlanSource {
  COACH // generated by the LLM and passed the verifier
  DEFAULT // rule-based fallback after a failed regeneration
  TEMPLATE // a program template (D38), as written or with the user's accepted changes
}

model Plan {
  id              Int        @id @default(autoincrement())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  source          PlanSource
  active          Boolean    @default(true)
  // The program template this plan was built from (D38); null for plans built before
  // templates or without one. The id names a file in src/data/programTemplates; the
  // version says which edition of it.
  templateId      String?
  templateVersion Int?
  createdAt       DateTime   @default(now())

  days     PlanDay[]
  workouts Workout[]

  // One active plan per user, held by the database (#76): the quiz save and saveWeek
  // each deactivate the old plan and insert a new one under different locks, and a
  // race between them left two active plans (docs/RESEARCH.md, D2 constraints).
  // Unique only among active plans: Prisma still offers userId as a unique key, but
  // never use it in findUnique, update, upsert or delete, which would match inactive
  // plans too. Find the active plan with findFirst({ where: { userId, active: true } }).
  @@unique([userId], where: { active: true }, map: "Plan_one_active_per_user")
  // Postgres does not index foreign keys on its own. The session screen and actions, and the coach context,
  // look up the user's newest active plan; onboarding and saveWeek deactivate the old
  // one: where userId and active, order by createdAt (#76).
  @@index([userId, active, createdAt])
}

// A strength day holds exercise slots; a run day holds one PlanRun; a rest day holds
// neither. Running days are built by rule, not by the model (#34).
enum DayKind {
  STRENGTH
  RUN
  REST
}

enum RunType {
  EASY
  TEMPO
  INTERVALS
  HILLS
  LONG
}

// Suggested training days for a plan day (D38); the user can move them.
enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model PlanDay {
  id       Int       @id @default(autoincrement())
  planId   Int
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayIndex Int // 0-based position in the week
  name     String // "Push", "Lower body"...
  kind     DayKind   @default(STRENGTH)
  weekdays Weekday[] @default([]) // empty for plans built before D38

  exercises PlanExercise[]
  run       PlanRun?
  workouts  Workout[]

  @@unique([planId, dayIndex])
}

// One exercise slot on one plan day. The verifier's coaching ranges (sets, reps, rest)
// are enforced in code, because they are coaching decisions; the database holds only
// sanity bounds (sets and reps at least 1, rest and order at least 0) in migration
// 20261124180300_range_checks.
model PlanExercise {
  id                 Int      @id @default(autoincrement())
  planDayId          Int
  planDay            PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise @relation(fields: [exerciseId], references: [id])
  order              Int
  sets               Int
  reps               Int
  restSeconds        Int
  substitutionReason String?

  @@unique([planDayId, exerciseId]) // no exercise twice on one day (verifier rule)
  @@unique([planDayId, order])
}

// The run on a run day. Distance and pace come from the running builder; the
// verifier caps the week-on-week increase in total distance (#34).
model PlanRun {
  id                 Int     @id @default(autoincrement())
  planDayId          Int     @unique
  planDay            PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  type               RunType
  distanceKm         Decimal @db.Decimal(5, 2)
  targetPaceSecPerKm Int? // null for an easy run done by feel
}

// ---------------------------------------------------------------------------
// Workouts and logging
// ---------------------------------------------------------------------------

model Workout {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          Int?
  plan            Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planDayId       Int?
  planDay         PlanDay?  @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  distanceKm      Decimal?  @db.Decimal(6, 2)
  durationSeconds Int?
  notes           String?
  // "live" for a workout logged in the app, "hevy-import" for one read from an export (#131).
  source          String    @default("live")
  // The imported workout's start time and title, so uploading a file twice adds nothing.
  importKey       String?

  sets          SetLog[]
  queuedSetKeys QueuedSetKey[]
  run           RunLog?

  // One open workout per plan (#76): Start looks for an open workout, then creates one,
  // so two taps could open two. Per plan, not per user: a plan switch leaves the old
  // plan's open workout open, and Start must still work on the new plan. Unique only
  // among open workouts: never use planId as a key in findUnique, update, upsert or
  // delete, which would match finished workouts too; filter with
  // findFirst({ where: { planId, finishedAt: null } }).
  @@unique([planId], where: { finishedAt: null }, map: "Workout_one_open_per_plan")
  // Uploading the same Hevy file twice adds nothing (#131).
  @@unique([userId, importKey])
  // The session screen, actions and coach context find the open workout and count finished ones:
  // where userId, planId and finishedAt (#76). No startedAt column: for sort order
  // Postgres does not treat finishedAt IS NULL as an equality, so the startedAt sort
  // runs on the few matched rows either way (one open workout per plan, held above).
  // The lookups by plan.active (no planId) seek on userId and check finishedAt inside
  // the index.
  // The progress page (progress/load.ts) uses the userId prefix and sorts by startedAt.
  @@index([userId, planId, finishedAt])
  // Deleting a plan or a plan day sets these to null; the indexes let Postgres find
  // the workouts without scanning the table (#76). Workout_one_open_per_plan covers
  // only open workouts and the composite above leads with userId, so neither serves
  // this.
  @@index([planId])
  @@index([planDayId])
}

model SetLog {
  id                Int      @id @default(autoincrement())
  workoutId         Int
  workout           Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise @relation(fields: [exerciseId], references: [id])
  setNumber         Int
  reps              Int
  weightKg          Decimal? @db.Decimal(6, 2)
  rpe               Int? // rate of perceived exertion, 1 to 10
  painDuringSession Int?
  painNextMorning   Int?
  loggedAt          DateTime @default(now())

  // One row per set, so saving the same set again after a dropped connection updates
  // it instead of logging it twice (#42).
  @@unique([workoutId, exerciseId, setNumber])
}

// Every clientId the offline queue has applied (D31): crypto.randomUUID() from the device,
// one per set attempt. One row per key, written in the same transaction as the set, so a
// replay of any earlier attempt (not only the latest edit) is answered "already saved"
// and can never overwrite a later edit. Removed with the workout.
model QueuedSetKey {
  workoutId  Int
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  clientId   String
  exerciseId String
  setNumber  Int
  createdAt  DateTime @default(now())

  @@id([workoutId, clientId])
}

// One run per workout; the unique workoutId makes a repeated save idempotent (#42).
// Written for runs logged by hand on the Progress page (D27), with the workout's
// distance and time. Upper CHECKs (300 km, 24 hours) are in migration
// 20261124200000_run_log_upper_bounds, the lower ones in the range checks below.
model RunLog {
  id          Int      @id @default(autoincrement())
  workoutId   Int      @unique
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  type        RunType?
  distanceKm  Decimal  @db.Decimal(5, 2)
  durationSec Int
  rpe         Int? // rate of perceived exertion, 1 to 10
  loggedAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Coach records and conversations
// ---------------------------------------------------------------------------

enum CoachEventKind {
  plan
  chat
}

// Keep in sync with CoachOutcome in src/lib/coach/coachLog.ts.
enum CoachEventOutcome {
  ok
  retried
  switched
  rejected
  error
  rule_based
  cached
}

// One record per coach call. Prompt/profile input is deliberately not stored.
model CoachEvent {
  id               Int               @id @default(autoincrement())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             CoachEventKind
  promptVersion    String
  attempt          Int
  latencyMs        Int
  outcome          CoachEventOutcome
  provider         String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  guardrailVerdict String?
  providerEvents   Json
  problems         Json?
  raw              Json?
  createdAt        DateTime          @default(now())

  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

// The model is stateless; the conversation lives here, scoped to the user, so one
// user's data never reaches another user's request (docs/ARCHITECTURE.md, The coach).
model Conversation {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // Set when the user opens the chat from the body map, so the next plan can account
  // for where they felt a movement (proposal section 1; #15).
  exerciseId     String?
  exercise       Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  bodyRegion     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Progress photos
// ---------------------------------------------------------------------------

// Photos live in a private Spaces bucket; only the object key is stored here and the
// app hands out short-lived signed URLs (decision D3).
model ProgressPhoto {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  takenAt    DateTime @default(now())
  weightKg   Decimal? @db.Decimal(5, 2)
  note       String?
}

// One weigh-in per user per day (D24, #16); logging the same day again
// replaces it. The 20 to 400 kg and 300-character bounds are CHECKs in the
// migration, since Prisma's schema has no CHECK.
model BodyWeight {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(5, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also serves the chart's query (this user's rows by date).
  @@unique([userId, date])
}

// Better Auth persistence. Existing user IDs and fitness relations are preserved.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Stripe test-mode data. Trial dates remain on User as the one-time-use marker.
model BillingAccount {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripeCheckoutSessionId String?   @unique
  checkoutAttempt         Int       @default(0)
  status                  String?
  stripePriceId           String?
  paidUntil               DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  lastSyncedAt            DateTime?
  updatedAt               DateTime  @updatedAt
}

// Stored only after successful processing, in the same transaction as tier updates.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Data exports (D33)
// ---------------------------------------------------------------------------

enum ExportKind {
  WORKOUT_CSV
  COACH_CSV
  MONTHLY_REPORT
}

// A file the server generated for the user and stored in R2: only the key lives here.
// A download finds the row with where { id, userId }, so one user can never sign another's file.
// The bytes > 0 CHECK is in the migration, since Prisma's schema has no CHECK.
model DataExport {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ExportKind
  r2Key     String     @unique
  bytes     Int
  createdAt DateTime   @default(now())

  // The "Your data" list, newest first, and the retention and rate-limit counts.
  @@index([userId, createdAt])
}
