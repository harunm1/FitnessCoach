// FitnessCoach data model. Prisma ORM v7, PostgreSQL (ECE1724 Lecture 3, pp. 44 to 66).
// Schema is what the database should look like; migrations are how it gets there
// (L3 p64). Change this file, then `npx prisma migrate dev --name <change>` and commit
// both the schema and the migration folder.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // `where` on @@unique (partial unique indexes on Plan and Workout), Preview since 7.4.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Range CHECK constraints on SetLog, RunLog, PlanExercise, PlanRun, PlanDay and Profile
// live only in migration 20261110220259_range_checks: Prisma cannot declare CHECK, so
// neither this file nor `prisma db pull` shows them (#76).

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

// The four access tiers checked on the server (docs/ARCHITECTURE.md, advanced features).
// FREE: quiz and a default plan. TRIAL and PRO: the coach. ADMIN: the exercise library.
enum Tier {
  FREE
  TRIAL
  PRO
  ADMIN
}

// String id and the name/email/emailVerified/image columns match what Better Auth's
// Prisma adapter expects, so the Accounts area can add its session and account tables
// without touching the rest of the schema.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  tier          Tier      @default(FREE)
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  billing  BillingAccount?

  profile       Profile?
  plans         Plan[]
  workouts      Workout[]
  conversations Conversation[]
  photos        ProgressPhoto[]
}

// ---------------------------------------------------------------------------
// Quiz and exercise library
// ---------------------------------------------------------------------------

enum Goal {
  STRENGTH
  MUSCLE
  FAT_LOSS
  GENERAL_FITNESS
}

enum Level {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

// What the user trains for: the gym, running or both (meeting 2, #12, #34).
enum TrainingMode {
  GYM
  RUNNING
  BOTH
}

// How active the user's day is outside training; with occupation it sets volume and
// rest days in the plan (#33, #34).
enum ActivityLevel {
  SEDENTARY // desk job or study
  LIGHT
  ACTIVE
  PHYSICAL_JOB // on their feet or lifting at work
}

// One profile per user: the quiz answers the coach is grounded on.
// One-to-one, so the foreign key lives here and is unique (L3 p61, L6 p37 on where
// the foreign key goes).
model Profile {
  id            Int           @id @default(autoincrement())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal
  level         Level
  trainingMode  TrainingMode  @default(GYM)
  daysPerWeek   Int
  // Equipment names from the exercise library ("barbell", "dumbbell", "body only"...),
  // so the verifier can check a plan against what the user actually has.
  equipment     String[]
  injuries      String?
  occupation    String? // free text from the quiz, e.g. "nurse, 12-hour shifts"
  activityLevel ActivityLevel @default(LIGHT)
  updatedAt     DateTime      @updatedAt
}

// Seeded from free-exercise-db (public domain, docs/RESEARCH.md). The coach picks
// exercises by id from this table and cannot name one we do not have.
model Exercise {
  id               String   @id // free-exercise-db slug, e.g. "Barbell_Bench_Press_-_Medium_Grip"
  name             String
  level            Level
  equipment        String?
  category         String
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  images           String[] // paths under the free-exercise-db image base URL
  // Form cues and common mistakes we write ourselves (issue #8); the coach's form
  // feedback must trace to this text, not to the model's own ideas.
  cues             String[]
  commonMistakes   String[]

  planExercises PlanExercise[]
  setLogs       SetLog[]
  messages      Message[]
}

// ---------------------------------------------------------------------------
// Plans
// ---------------------------------------------------------------------------

enum PlanSource {
  COACH // generated by the LLM and passed the verifier
  DEFAULT // rule-based fallback after a failed regeneration
}

model Plan {
  id        Int        @id @default(autoincrement())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  source    PlanSource
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  days     PlanDay[]
  workouts Workout[]

  // One active plan per user, held by the database (#76): the quiz save and saveWeek
  // each deactivate the old plan and insert a new one under different locks, and a
  // race between them left two active plans (docs/RESEARCH.md, D2 constraints).
  @@unique([userId], where: { active: true }, map: "Plan_one_active_per_user")
  // Postgres does not index foreign keys on its own. The session screen and actions
  // look up the user's newest active plan; onboarding and saveWeek deactivate the old
  // one: where userId and active, order by createdAt (#76).
  @@index([userId, active, createdAt])
}

// A strength day holds exercise slots; a run day holds one PlanRun; a rest day holds
// neither. Running days are built by rule, not by the model (#34).
enum DayKind {
  STRENGTH
  RUN
  REST
}

enum RunType {
  EASY
  TEMPO
  INTERVALS
  HILLS
  LONG
}

model PlanDay {
  id       Int     @id @default(autoincrement())
  planId   Int
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayIndex Int // 0-based position in the week
  name     String // "Push", "Lower body"...
  kind     DayKind @default(STRENGTH)

  exercises PlanExercise[]
  run       PlanRun?
  workouts  Workout[]

  @@unique([planId, dayIndex])
}

// One exercise slot on one plan day. The verifier's range checks (sets, reps, rest)
// are enforced in code, not here, because the ranges are coaching decisions.
model PlanExercise {
  id          Int      @id @default(autoincrement())
  planDayId   Int
  planDay     PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  order       Int
  sets        Int
  reps        Int
  restSeconds Int

  @@unique([planDayId, exerciseId]) // no exercise twice on one day (verifier rule)
  @@unique([planDayId, order])
}

// The run on a run day. Distance and pace come from the running builder; the
// verifier caps the week-on-week increase in total distance (#34).
model PlanRun {
  id                 Int     @id @default(autoincrement())
  planDayId          Int     @unique
  planDay            PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  type               RunType
  distanceKm         Decimal @db.Decimal(5, 2)
  targetPaceSecPerKm Int? // null for an easy run done by feel
}

// ---------------------------------------------------------------------------
// Workouts and logging
// ---------------------------------------------------------------------------

model Workout {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          Int?
  plan            Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planDayId       Int?
  planDay         PlanDay?  @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  distanceKm      Decimal?  @db.Decimal(6, 2)
  durationSeconds Int?
  notes           String?

  sets SetLog[]
  run  RunLog?

  // One open workout per plan (#76): Start looks for an open workout, then creates one,
  // so two taps could open two. Per plan, not per user: a plan switch leaves the old
  // plan's open workout open, and Start must still work on the new plan.
  @@unique([planId], where: { finishedAt: null }, map: "Workout_one_open_per_plan")
  // The session screen and actions find the open workout and count finished ones:
  // where userId, planId and finishedAt (#76). No startedAt column: Postgres does not
  // treat finishedAt IS NULL as an equality, so the startedAt sort runs on the few
  // matched rows either way (one open workout per plan, held above). The lookups by
  // plan.active (no planId) seek on userId and check finishedAt inside the index.
  @@index([userId, planId, finishedAt])
  // Deleting a plan or a plan day sets these to null; the indexes let Postgres find
  // the workouts without scanning the table (#76).
  @@index([planId])
  @@index([planDayId])
}

model SetLog {
  id         Int      @id @default(autoincrement())
  workoutId  Int
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Decimal? @db.Decimal(6, 2)
  rpe        Int? // rate of perceived exertion, 1 to 10
  loggedAt   DateTime @default(now())

  // One row per set, so saving the same set again after a dropped connection updates
  // it instead of logging it twice (#42).
  @@unique([workoutId, exerciseId, setNumber])
}

// One run per workout; the unique workoutId makes a repeated save idempotent (#42).
model RunLog {
  id          Int      @id @default(autoincrement())
  workoutId   Int      @unique
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  type        RunType?
  distanceKm  Decimal  @db.Decimal(5, 2)
  durationSec Int
  rpe         Int? // rate of perceived exertion, 1 to 10
  loggedAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Coach conversations
// ---------------------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
}

// The model is stateless; the conversation lives here, scoped to the user, so one
// user's data never reaches another user's request (docs/ARCHITECTURE.md, The coach).
model Conversation {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // Set when the user opens the chat from the body map, so the next plan can account
  // for where they felt a movement (proposal section 1; #15).
  exerciseId     String?
  exercise       Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  bodyRegion     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Progress photos
// ---------------------------------------------------------------------------

// Photos live in a private Spaces bucket; only the object key is stored here and the
// app hands out short-lived signed URLs (decision D3).
model ProgressPhoto {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  takenAt    DateTime @default(now())
  weightKg   Decimal? @db.Decimal(5, 2)
  note       String?
}

// Better Auth persistence. Existing user IDs and fitness relations are preserved.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Stripe test-mode data. Trial dates remain on User as the one-time-use marker.
model BillingAccount {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripeCheckoutSessionId String?   @unique
  checkoutAttempt         Int       @default(0)
  status                  String?
  stripePriceId           String?
  paidUntil               DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  lastSyncedAt            DateTime?
  updatedAt               DateTime  @updatedAt
}

// Stored only after successful processing, in the same transaction as tier updates.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
